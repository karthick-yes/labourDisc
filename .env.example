# Copy to .env for local dev. On Replit, set these in the Secrets tab.

# Local: matches docker-compose.yml. Replit sets this automatically when you add a database.
DATABASE_URL=postgres://panibook:panibook@localhost:5433/panibook

# Public URL of the app, used in WhatsApp share links.
APP_BASE_URL=http://localhost:3000

# Media storage: "local" (files in UPLOAD_DIR) for dev, "replit" on Replit deploys.
STORAGE_DRIVER=local
UPLOAD_DIR=uploads

# Demo enterprises are real shops, so their WhatsApp buttons are disabled.
# Set your own test number here to send demo cards to it instead.
DEMO_WHATSAPP_NUMBER=

# Optional: if set, new contractors must enter this code to sign up.
SIGNUP_CODE=

# --- Voice intake (OpenAI). Off until AI_ENABLED=true and a key is set. ---
# Use a dedicated OpenAI project key for this app only.
OPENAI_API_KEY=
# Defaults: gpt-4o-mini-transcribe (speech-to-text) and gpt-5-nano (form filling).
OPENAI_TRANSCRIBE_MODEL=
OPENAI_EXTRACT_MODEL=
AI_ENABLED=false
# Hard limits, checked before every OpenAI call (one voice intake ≈ $0.004).
AI_MONTHLY_CAP_USD=2
AI_DAILY_CAP_PER_CONTRACTOR_USD=0.1
AI_MAX_INTAKES_PER_DAY=5
AI_MAX_INTAKES_PER_HOUR_PER_CONTRACTOR=3
# PIN for the /admin usage page (owner only; use something long).
ADMIN_PIN=

# --- Free map services (OpenStreetMap). Answers are cached for 14 days. ---
OVERPASS_PER_DAY=40
OVERPASS_PER_CONTRACTOR_PER_DAY=10
NOMINATIM_PER_DAY=100
NOMINATIM_PER_CONTRACTOR_PER_DAY=20

# Optional, off by default
GOOGLE_MAPS_API_KEY=
